# ─── Appwrite Configuration ──────────────────────────────────────
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_API_KEY=your_api_key_here

# ─── Database IDs (must match init_db.py) ────────────────────────
APPWRITE_DATABASE_ID=yt_tracker_db
APPWRITE_CHANNELS_COLLECTION_ID=channels
APPWRITE_SUBSCRIPTIONS_COLLECTION_ID=subscriptions
APPWRITE_VIDEOS_COLLECTION_ID=videos

# ─── Gemini API ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=2048

# ─── Worker Tuning ──────────────────────────────────────────────
RSS_LOOKBACK_MINUTES=70
TRANSCRIPT_CHUNK_SIZE=4000
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
